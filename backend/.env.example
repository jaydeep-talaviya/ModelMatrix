# OpenAI
OPENAI_API_KEY=

# Gemini
GEMINI_API_KEY=

# Anthropic
ANTHROPIC_API_KEY=

# Puter free-tier demo (no provider key needed — get a free token at puter.com/dashboard)
# PUTER_AUTH_TOKEN=
# Comma-separated providers that run through Puter even when their own key is set (e.g. a key with no credits)
# PROVIDER_USING_PUTER=openai,anthropic
# How aggressively Puter free-tier concurrency is guarded (defaults shown)
# PUTER_MAX_CONCURRENCY=2
# PUTER_MAX_RETRIES=3
# PUTER_RETRY_BACKOFF_S=1.0